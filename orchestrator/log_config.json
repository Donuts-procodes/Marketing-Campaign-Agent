{
  "version": 1,
  "disable_existing_loggers": false,

  "_comment": "Passed to uvicorn via --log-config so the reloader supervisor uses this format too. configure_logging() applies the same setup in-process; this covers the lines emitted before the app is imported.",

  "formatters": {
    "orchestrator": {
      "()": "orchestrator.core.log_format.ColorFormatter"
    }
  },

  "filters": {
    "lifecycle_noise": {
      "()": "orchestrator.core.log_format.LifecycleNoiseFilter"
    },
    "polled_endpoints": {
      "()": "orchestrator.core.log_format.AccessLogFilter"
    }
  },

  "handlers": {
    "default": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "orchestrator",
      "filters": ["lifecycle_noise"]
    },
    "access": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "orchestrator",
      "filters": ["polled_endpoints"]
    }
  },

  "loggers": {
    "uvicorn": { "handlers": ["default"], "level": "INFO", "propagate": false },
    "uvicorn.error": { "handlers": ["default"], "level": "INFO", "propagate": false },
    "uvicorn.access": { "handlers": ["access"], "level": "INFO", "propagate": false },
    "orchestrator": { "handlers": ["default"], "level": "INFO", "propagate": false },

    "httpx": { "level": "WARNING" },
    "httpcore": { "level": "WARNING" },
    "urllib3": { "level": "WARNING" },
    "watchfiles": { "level": "WARNING" },
    "pymongo": { "level": "WARNING" },
    "openai": { "level": "WARNING" }
  }
}
