    class ROOT_ENGINE rootNode;
    class STRAT_COORD stratLead;
    class PUB_COORD pubLead;
    class REDIS_CLUSTER,MONGO_DB,S3_BUCKET dbNode;
    class RES_HYDRATE,RES_DISCOVER,RES_SYNTH,PER_PROFILE,PER_ENRICH,PER_SYNTH,CAM_DECOMP,CAM_COMMIT stratNode;
    class MED_VISION,MED_DIFFUSION,MED_SETUP,PUB_OPTIMAL,PUB_ENQUEUE,PUB_DISPATCH,PUB_CONFIRM,PUB_RETRY,STAGE_POLL,STAGE_BUFFER,STAGE_EMIT pubNode;
    class SDK_LLM,SDK_DATA,SDK_ADS toolNode;
    class RES_GATE,PER_GATE,CAM_HITL,MED_POLICY,MED_HITL,PUB_GATE,STAGE_GATE gateNode;
