    style SUB_ORCH_STRATEGY fill:#f0f9ff,stroke:#7dd3fc,stroke-width:1.5px,color:#0369a1
    style SUB_ORCH_PUBLISHER fill:#faf5ff,stroke:#d8b4fe,stroke-width:1.5px,color:#6b21a8
